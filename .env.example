# Copier en .env.local pour le développement.
# Sur Vercel : Settings > Environment Variables, pour Production ET Preview.

# Clé API Resend (https://resend.com/api-keys).
# Sans elle, le formulaire affiche un message d'indisponibilité et invite à
# écrire directement — il n'échoue jamais en silence.
RESEND_API_KEY=

# Destinataire des demandes d'étude.
CONTACT_TO=contact@knxmaroc.ma

# Expéditeur. Le domaine doit être vérifié dans Resend
# (Domains > Add Domain, puis les enregistrements DNS chez le registrar).
CONTACT_FROM="Site KNX MAROC <site@knxmaroc.ma>"

# Higgsfield AI Integration & MCP Server
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_CDN_BASE=https://d8j0ntlcm91z4.cloudfront.net/user_3H0ObVqxuFE92uSehkAHQtDZLyP

